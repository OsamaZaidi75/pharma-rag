# Copy to .env and adjust
CHROMA_DIR=./data/chroma
SPL_CACHE_DIR=./data/spl_cache

# Vector store: Qdrant Cloud when BOTH QDRANT_URL and QDRANT_API_KEY are
# set; otherwise local ChromaDB (CHROMA_DIR) is used. The Qdrant
# collection is created automatically on first use (4096-dim, Cosine).
# QDRANT_URL=https://<your-cluster>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=pharma_rag

# Embeddings (NVIDIA API — same key as the LLM; no local model, no torch).
# The 8b model is 4096-dim; if you switch models, set EMBEDDING_DIM to
# match and rebuild the ChromaDB index (old vectors are incompatible).
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
EMBEDDING_DIM=4096

# LLM provider: "nvidia" (hosted default) | "ollama" | "gemini" | "openai"
# With no LLM reachable (no key set and no Ollama server running), /ask
# answers with the built-in extractive fallback — still cited, no key needed.
# Agent mode (/ask-agent) needs a working LLM; it errors without one.
LLM_PROVIDER=nvidia
# NVIDIA API (OpenAI-compatible). Key goes in the container env file at
# deploy time — never commit a real key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Local alternatives (not used by the hosted demo):
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Gemini (free tier): set LLM_PROVIDER=gemini + GEMINI_API_KEY
# (get a key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# OpenAI: set LLM_PROVIDER=openai + OPENAI_API_KEY
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Deprecated: cross-encoder reranking was removed (torch removal, 2026-11-18);
# accepted but ignored — RRF order is final.
USE_RERANKER=false

# Chunking
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# API / UI
API_URL=http://localhost:8000
